REFORMULATION_DB_PATH=/app/data/reformulation_assurance_v06.db
REFORMULATION_ARTIFACT_ROOT=/app/data/artifacts
REFORMULATION_PUBLIC_URL=http://localhost:8501
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REFORMULATION_ARTIFACT_KEY=
REFORMULATION_BACKUP_INTERVAL_HOURS=24

# Optional email delivery. Without these, messages remain visible in the database outbox.
REFORMULATION_SMTP_HOST=
REFORMULATION_SMTP_PORT=587
REFORMULATION_SMTP_USERNAME=
REFORMULATION_SMTP_PASSWORD=
REFORMULATION_EMAIL_FROM=
REFORMULATION_SMTP_TLS=true
